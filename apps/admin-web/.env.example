# Admin web — copy to .env.local and fill in values.
# API
NEXT_PUBLIC_API_URL=http://localhost:3000/v1

# Society UUID for OTP (SendOtpDto / VerifyOtpDto). Use the same value as staff/resident apps.
NEXT_PUBLIC_SOCIETY_ID=

# Sentry — server DSN (kept private), public DSN exposed to client bundle.
SENTRY_DSN_ADMIN=
NEXT_PUBLIC_SENTRY_DSN_ADMIN=
SENTRY_RELEASE=

# Sentry CLI (build-time sourcemap upload)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
