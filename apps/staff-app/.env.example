# Staff app — copy to .env and fill in values.
# API
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Sentry (optional in dev). EXPO_PUBLIC_* is exposed to the bundle.
EXPO_PUBLIC_SENTRY_DSN_STAFF=
SENTRY_RELEASE=

# Sentry CLI (used by sourcemap:upload script)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
