{
  "expo": {
    "name": "Marzi Staff App",
    "slug": "societyos-staff",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6E0043"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.societyos.staff",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6E0043"
      },
      "package": "com.marzi.staff",
      "googleServicesFile": "./google-services.json",
      "permissions": ["POST_NOTIFICATIONS", "VIBRATE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SocietyOS Staff to access camera for QR scanning."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SocietyOS Staff to use location for geofence check-in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6E0043",
          "defaultChannel": "system"
        }
      ],
      "expo-local-authentication",
      "expo-font",
      "expo-audio",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "societyos-staff",
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": false
  }
}
