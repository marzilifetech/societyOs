{
  "expo": {
    "name": "Marzi Staff App",
    "slug": "societyos-staff",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6E0043"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marzi.staff",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6E0043"
      },
      "package": "com.marzi.staff",
      "googleServicesFile": "./google-services.json",
      "permissions": ["POST_NOTIFICATIONS", "VIBRATE"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Marzi Staff uses the camera to scan visitor passes and photograph completed work.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Marzi Staff lets you attach photos of your work and your documents.",
          "cameraPermission": "Marzi Staff uses the camera to photograph completed work and documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Marzi Staff uses your location to confirm you are at the society when you check in.",
          "locationAlwaysAndWhenInUsePermission": "Marzi Staff uses your location to confirm you are at the society when you check in.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6E0043",
          "defaultChannel": "system"
        }
      ],
      "expo-local-authentication",
      "expo-font",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "societyos-staff",
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": false
  }
}
