{
  "expo": {
    "name": "One Community",
    "slug": "societyos-resident",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6E0043"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.societyos.resident",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6E0043"
      },
      "package": "com.marzi.resident",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6E0043",
          "sounds": []
        }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "One Community uses the camera to photograph a visitor you are pre-approving, to scan visitor QR passes, and to capture your ID documents for society verification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "One Community uses the camera to photograph a visitor you are pre-approving, to scan visitor QR passes, and to capture your ID documents for society verification.",
          "photosPermission": "One Community lets you choose photos from your library to attach to a complaint, a visitor pass or your ID documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "When you raise an Emergency SOS, One Community shares your location with your society's security team so they can reach you quickly.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "One Community uses Face ID so you can sign back in quickly and securely."
        }
      ]
    ],
    "scheme": "societyos",
    "extra": {},
    "newArchEnabled": false
  }
}
