{
  "expo": {
    "name": "One Community",
    "slug": "societyos-resident",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6E0043"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.societyos.resident",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for visitor photo and proof of work",
        "NSLocationWhenInUseUsageDescription": "Used for SOS location and geofencing",
        "NSPhotoLibraryUsageDescription": "Used to upload photos"
      }
    },
    "android": {
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6E0043"
      },
      "package": "com.marzi.resident",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6E0043",
          "sounds": []
        }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "societyos",
    "extra": {},
    "newArchEnabled": false
  }
}
