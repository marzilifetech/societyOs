# Resident app — copy to .env and fill in values.
# API
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Razorpay (test-mode key in dev)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Sentry (optional in dev). EXPO_PUBLIC_* is exposed to the bundle.
EXPO_PUBLIC_SENTRY_DSN_RESIDENT=
SENTRY_RELEASE=

# Sentry CLI (used for sourcemap upload)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
