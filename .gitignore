node_modules
.turbo
dist
.next
.expo
*.tsbuildinfo
.env
.env.local
.env.*.local
.env.*
!.env.example
coverage
.DS_Store
*.log
prisma/migrations/dev
.dev-pids

# additional ignores
.logs
.dev-logs
.pnpm-store
.expo-shared

# Native projects — Expo CNG output, regenerated by `expo prebuild` (do not commit)
apps/*/android/
apps/*/ios/
# Expo-generated types
expo-env.d.ts
# Build outputs / binaries — never commit (belt-and-suspenders if a native dir is re-added)
*.apk
*.aab
*.ipa
*.keystore
!debug.keystore
*.jks
*.xcworkspace/xcuserdata
*.xcodeproj/xcuserdata

# editor / agent metadata
.claude/
.cursor/
.copilot/

# Playwright — local auth state and run artifacts
apps/admin-web/e2e/.auth/
apps/admin-web/test-results/
apps/admin-web/playwright-report/

# secrets / credentials — never commit
creds.txt
*.pem
*creds*
secrets.*

# EAS local signing — credentials.json holds keystore + key passwords in plaintext;
# play-store-key.json is the Play service-account key. Never commit either.
**/credentials.json
**/play-store-key.json

# Firebase — service-account keys & client config (never commit)
*firebase-adminsdk*.json
**/google-services.json
**/GoogleService-Info.plist

# Deploy-time materialised runtime secret (infra/instance/deploy.sh) — never commit
backend.env

# Terraform — state holds generated secrets in plaintext; tfvars holds tokens
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
keystores/
builds/
figma images/
mock-data/
