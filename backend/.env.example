NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Required (joi will fail-fast if missing) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/societyos
JWT_SECRET=change-me-in-production-min-16-chars
JWT_REFRESH_SECRET=change-me-in-production-min-16-chars
REDIS_URL=redis://localhost:6379
AWS_REGION=ap-south-1

# --- Optional ---
# Short access-token TTL is paired with refresh-token rotation (see
# JWT_REFRESH_EXPIRES_IN). The mobile clients auto-refresh on 401 with
# code TOKEN_EXPIRED, so 15m is invisible to users while strongly limiting
# the blast radius of a leaked AT.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_SECRET=

# External Marzi Senior Community backend integration.
# Set to true ONLY in local dev to enable /auth/send-otp + /auth/verify-otp
# locally. In prod the client must use the external backend for OTP; JwtStrategy
# verifies the externally-issued JWT using the shared JWT_SECRET (HS256).
AUTH_LOCAL_OTP_ENABLED=true

# OTP source for /auth/send-otp + /auth/verify-otp:
#   local → in-house Redis OTP (dev magic code 123456 when NODE_ENV!=production)
#   marzi → proxy send/verify to the external Marzi backend at MARZI_AUTH_BASE_URL.
#           SocietyOS still mints its own JWTs, so no shared JWT secret is needed.
OTP_PROVIDER=local
MARZI_AUTH_BASE_URL=https://dev.marzitech.in
# Exact white-label tenant name registered on the Marzi backend (case-insensitive).
MARZI_TENANT_NAME=Marzi

AWS_S3_BUCKET=societyos-dev-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated allowlist; "*" rejected in production
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Body size cap (incl. JSON; raw applied to webhooks)
BODY_LIMIT=1mb

# --- Throttler quotas ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_LIMIT_AUTH=10
THROTTLE_LIMIT_SOS=5

# --- Razorpay (P2) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase / Push (P2) ---
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SA_BASE64=

# --- Sentry ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Auth refresh token (P2) ---
JWT_REFRESH_EXPIRES_IN=30d

# --- TOTP / 2FA (P2) ---
TOTP_ISSUER=SocietyOS

# --- Socket.io horizontal scale (P2, optional) ---
SOCKET_IO_REDIS_ADAPTER=false

# --- PII column-level encryption (P3) — 32-byte hex (64 chars) ---
PII_ENCRYPTION_KEY=

# --- Swagger gating (prod basic-auth; leave blank to disable in prod) ---
SWAGGER_USER=
SWAGGER_PASS=

# --- Pagination defaults ---
LIST_DEFAULT_LIMIT=50
LIST_MAX_LIMIT=200
