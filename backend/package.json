{
  "name": "@societyos/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.container",
    "start:container": "node dist/main.container",
    "lambda:smoke": "ts-node --transpile-only src/lambda/smoke.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:coverage:features": "jest --coverage --collectCoverageFrom='src/modules/service-request/service-request.service.ts' --collectCoverageFrom='src/modules/service-request/service-request-reminder.scheduler.ts' --collectCoverageFrom='src/modules/visitor/visitor.service.ts' --collectCoverageFrom='src/modules/admin/admin.service.ts' --collectCoverageFrom='src/modules/auth/auth.service.ts' --collectCoverageFrom='src/modules/notice/notice.service.ts' --collectCoverageFrom='src/common/notification/whatsapp.service.ts' --collectCoverageFrom='src/modules/help-request/help-request.service.ts'",
    "test:e2e": "jest --config test/jest-e2e.json",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
