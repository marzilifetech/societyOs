  specialInstructions String?
  status              LaundryStatus @default(REQUESTED)
  pickupPhotoUrl      String?
  deliveryPhotoUrl    String?
  scheduledPickup     DateTime
  rating              Decimal?      @db.Decimal(3, 2)
  ratingText          String?
  createdAt           DateTime      @default(now())

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@map("laundry_requests")
}

// ─── Packages ─────────────────────────────────────────────────────────────────

model Package {
  id             String        @id @default(cuid())
  residentId     String
  societyId      String
  courierName    String
  trackingNumber String?
  description    String?
  photoUrl       String
  arrivedAt      DateTime      @default(now())
  collectedAt    DateTime?
  status         PackageStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  resident Resident @relation(fields: [residentId], references: [id])
  society  Society  @relation(fields: [societyId], references: [id])

  @@index([residentId])
  @@index([societyId])
  @@map("packages")
}

// ─── Concierge ────────────────────────────────────────────────────────────────

model ConciergeRequest {
  id                 String               @id @default(cuid())
  societyId          String
  residentId         String
  type               ConciergeRequestType @default(OTHER)
  description        String
  scheduledTime      DateTime?
  status             ConciergeStatus      @default(PENDING)
  assignedStaffId    String?
  completionPhotoUrl String?
  completionNotes    String?
  note               String?
  rating             Decimal?             @db.Decimal(3, 2)
  ratingText         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  society  Society  @relation(fields: [societyId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@index([societyId])
  @@map("concierge_requests")
}

// ─── Feedback ─────────────────────────────────────────────────────────────────

model Feedback {
  id          String           @id @default(cuid())
  residentId  String
  societyId   String
  category    FeedbackCategory @default(OTHER)
  message     String
  isAnonymous Boolean          @default(false)
  status      FeedbackStatus   @default(SUBMITTED)
  adminReply  String?
  rating      Decimal?         @db.Decimal(3, 2)
  createdAt   DateTime         @default(now())

  resident Resident @relation(fields: [residentId], references: [id])
  society  Society  @relation(fields: [societyId], references: [id])

  @@index([residentId])
  @@index([societyId])
  @@map("feedback")
}

// ─── Dish Ratings ─────────────────────────────────────────────────────────────

model DishRating {
  id         String   @id @default(cuid())
  dishId     String
  residentId String
  rating     Decimal  @db.Decimal(3, 2)
  comment    String?
  createdAt  DateTime @default(now())

  dish     CanteenDish @relation(fields: [dishId], references: [id])
  resident Resident    @relation(fields: [residentId], references: [id])

  @@unique([dishId, residentId])
  @@index([dishId])
  @@map("dish_ratings")
}

// ─── Event Feedback ───────────────────────────────────────────────────────────

model EventFeedback {
  id         String   @id @default(cuid())
  eventId    String
  residentId String
  rating     Decimal  @db.Decimal(3, 2)
  comment    String?
  createdAt  DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  @@unique([eventId, residentId])
  @@index([eventId])
  @@map("event_feedback")
}

// ─── Emergency Contacts ───────────────────────────────────────────────────────

model EmergencyContact {
  id        String   @id @default(cuid())
  societyId String
  label     String
  phone     String
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@map("emergency_contacts")
}

// ─── Security Rounds ──────────────────────────────────────────────────────────

model SecurityRound {
  id          String      @id @default(cuid())
  societyId   String
  staffId     String
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  durationMin Int?
  notes       String?
  status      RoundStatus @default(IN_PROGRESS)
  createdAt   DateTime    @default(now())

  society Society     @relation(fields: [societyId], references: [id])
  staff   StaffMember @relation(fields: [staffId], references: [id])

  @@index([societyId])
  @@map("security_rounds")
}

// ─── Society Budget ───────────────────────────────────────────────────────────

model SocietyBudget {
  id          String   @id @default(cuid())
  societyId   String
  month       Int
  year        Int
  totalIncome Decimal  @db.Decimal(14, 2)
  lineItems   Json     @default("[]")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@unique([societyId, year, month])
  @@index([societyId])
  @@map("society_budgets")
}

// ─── Help Requests ────────────────────────────────────────────────────────────

model HelpRequest {
  id                 String    @id @default(cuid())
  residentId         String
  societyId          String
  title              String
  description        String
  category           String?
  status             String    @default("OPEN")
  rating             Decimal?  @db.Decimal(3, 2)
  ratingText         String?
  completionPhotoUrl String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([residentId])
  @@index([societyId])
  @@map("help_requests")
}

// ─── Travel Requests ──────────────────────────────────────────────────────────

model TravelRequest {
  id              String              @id @default(cuid())
  residentId      String
  startDate       DateTime
  returnDate      DateTime
  servicesToPause Json                @default("[]")
  status          TravelRequestStatus @default(PENDING)
  adminNotes      String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@map("travel_requests")
}

// ─── Property Interests ───────────────────────────────────────────────────────

model PropertyInterest {
  id         String   @id @default(cuid())
  listingId  String
  residentId String
  message    String?
  createdAt  DateTime @default(now())

  listing  PropertyListing @relation(fields: [listingId], references: [id])
  resident Resident        @relation(fields: [residentId], references: [id])

  @@unique([listingId, residentId])
  @@index([listingId])
  @@map("property_interests")
}

// ─── Wallet ───────────────────────────────────────────────────────────────────

model WalletTransaction {
  id          String          @id @default(cuid())
  residentId  String
  amount      Decimal
  type        WalletTxnType
  status      WalletTxnStatus @default(COMPLETED)
  description String?
  reference   String?
  createdAt   DateTime        @default(now())

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@map("wallet_transactions")
}

// ─── Laundry Bookings ─────────────────────────────────────────────────────────

model LaundryBooking {
  id          String               @id @default(cuid())
  societyId   String
  residentId  String
  scheduledAt DateTime
  type        LaundryType          @default(WASH_AND_FOLD)
  itemCount   Int                  @default(1)
  notes       String?
  status      LaundryBookingStatus @default(SCHEDULED)
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  society  Society  @relation(fields: [societyId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  @@index([societyId])
  @@index([residentId])
  @@map("laundry_bookings")
}

// ─── Security Incidents ───────────────────────────────────────────────────────

model SecurityIncident {
  id          String           @id @default(cuid())
  societyId   String
  reportedBy  String
  type        IncidentType
  description String
  severity    IncidentSeverity @default(LOW)
  status      IncidentStatus   @default(OPEN)
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@map("security_incidents")
}

// ─── Medication Doses ─────────────────────────────────────────────────────────

model MedicationDose {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  date         DateTime   // date this dose is scheduled for (date portion only)
  slot         String     // morning | afternoon | evening | night
  taken        Boolean    @default(false)
  takenAt      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([medicationId, date, slot])
  @@index([medicationId, date])
  @@map("medication_doses")
}

// ─── Post Likes ───────────────────────────────────────────────────────────────

model PostLike {
  id         String        @id @default(cuid())
  postId     String
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  residentId String
  resident   Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([postId, residentId])
  @@map("post_likes")
}

// ─── Housekeeping Requests ────────────────────────────────────────────────────

model HousekeepingRequest {
  id          String   @id @default(cuid())
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  societyId   String
  society     Society  @relation(fields: [societyId], references: [id])
  type        String   // DEEP_CLEAN | REGULAR | BATHROOM | KITCHEN | WINDOWS
  scheduledAt DateTime
  notes       String?
  status      String   @default("PENDING") // PENDING | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  staffId     String?
  rating      Int?
  review      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([residentId])
  @@index([societyId, status])
  @@index([scheduledAt])
  @@map("housekeeping_requests")
}

// ─── Pest Control Schedules ───────────────────────────────────────────────────

model PestControlSchedule {
  id          String   @id @default(cuid())
  societyId   String
  society     Society  @relation(fields: [societyId], references: [id])
  type        String   // MOSQUITO | COCKROACH | RODENT | TERMITE | GENERAL
  scheduledAt DateTime
  areas       String[]
  notes       String?
  status      String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([societyId, scheduledAt])
  @@map("pest_control_schedules")
}

// ─── Canteen Pre-Orders ───────────────────────────────────────────────────────

model CanteenPreOrder {
  id          String   @id @default(cuid())
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  societyId   String
  society     Society  @relation(fields: [societyId], references: [id])
  items       Json     // [{dishId, name, quantity, unitPrice}]
  totalAmount Decimal  @db.Decimal(10, 2)
  pickupAt    DateTime
  status      String   @default("PENDING") // PENDING | CONFIRMED | READY | COLLECTED | CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([residentId])
  @@index([societyId, pickupAt])
  @@map("canteen_pre_orders")
}

// ─── Vendors ──────────────────────────────────────────────────────────────────

model Vendor {
  id        String        @id @default(cuid())
  societyId String
  society   Society       @relation(fields: [societyId], references: [id])
  name      String
  category  String        // GROCERY | PHARMACY | BAKERY | DAIRY | VEGETABLES | OTHER
  phone     String?
  logoUrl   String?
  isActive  Boolean       @default(true)
  orders    VendorOrder[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([societyId, category])
  @@map("vendors")
}

// ─── Vendor Orders ────────────────────────────────────────────────────────────

model VendorOrder {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  societyId   String
  society     Society  @relation(fields: [societyId], references: [id])
  items       Json     // [{name, quantity, unitPrice}]
  totalAmount Decimal  @db.Decimal(10, 2)
  status      String   @default("PENDING") // PENDING | CONFIRMED | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  notes       String?
  deliveryAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([residentId])
  @@index([vendorId, status])
  @@index([societyId])
  @@map("vendor_orders")
}
