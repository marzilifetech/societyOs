  status         DomesticAttendanceStatus
  notes          String?
  createdAt      DateTime                 @default(now())

  domesticHelp DomesticHelp @relation(fields: [domesticHelpId], references: [id])

  @@index([domesticHelpId])
  @@map("domestic_attendance")
}

// ─── Parking & Vehicles ───────────────────────────────────────────────────────

model ParkingSlot {
  id         String          @id @default(cuid())
  societyId  String
  slotNumber String
  type       ParkingSlotType @default(OWNED)
  isOccupied Boolean         @default(false)
  createdAt  DateTime        @default(now())

  society   Society    @relation(fields: [societyId], references: [id])
  residents Resident[]

  @@index([societyId])
  @@map("parking_slots")
}

model Vehicle {
  id          String      @id @default(cuid())
  residentId  String
  plateNumber String
  make        String?
  model       String?
  color       String?
  type        VehicleType @default(CAR)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@map("vehicles")
}

// ─── Community ────────────────────────────────────────────────────────────────

model CommunityPost {
  id          String              @id @default(cuid())
  residentId  String
  societyId   String
  content     String
  photoUrls   Json                @default("[]")
  isAnonymous Boolean             @default(false)
  status      CommunityPostStatus @default(ACTIVE)
  reactions   Int                 @default(0)
  createdAt   DateTime            @default(now())

  resident Resident      @relation(fields: [residentId], references: [id])
  society  Society       @relation(fields: [societyId], references: [id])
  comments PostComment[]
  likes    PostLike[]

  @@index([societyId])
  @@index([societyId, status])
  @@index([residentId])
  @@map("community_posts")
}

model PostComment {
  id         String   @id @default(cuid())
  postId     String
  residentId String
  content    String
  createdAt  DateTime @default(now())

  post     CommunityPost @relation(fields: [postId], references: [id])
  resident Resident      @relation(fields: [residentId], references: [id])

  @@index([postId])
  @@map("post_comments")
}

// ─── AGM ──────────────────────────────────────────────────────────────────────

model AgmMeeting {
  id         String           @id @default(cuid())
  societyId  String
  title      String
  date       DateTime
  agenda     Json             @default("[]")
  status     AgmMeetingStatus @default(UPCOMING)
  minutesUrl String?
  createdAt  DateTime         @default(now())

  society     Society         @relation(fields: [societyId], references: [id])
  resolutions AgmResolution[]

  @@index([societyId])
  @@map("agm_meetings")
}

model AgmResolution {
  id          String              @id @default(cuid())
  meetingId   String
  title       String
  description String
  votes       Json                @default("{}")
  result      AgmResolutionResult @default(PENDING)
  createdAt   DateTime            @default(now())

  meeting AgmMeeting @relation(fields: [meetingId], references: [id])

  @@index([meetingId])
  @@map("agm_resolutions")
}

// ─── Document Requests ────────────────────────────────────────────────────────

model DocumentRequest {
  id          String                @id @default(cuid())
  residentId  String
  societyId   String
  type        DocumentRequestType
  purpose     String
  requiredBy  DateTime?
  status      DocumentRequestStatus @default(PENDING)
  documentUrl String?
