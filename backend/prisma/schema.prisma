generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  RESIDENT
  STAFF
  ADMIN
  BUILDING_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

enum ResidentType {
  OWNER
  TENANT
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum ServiceRequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CLOSED
}

enum ServicePhase {
  BEFORE
  DURING
  AFTER
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
  REJECTED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SosStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  FALSE_ALARM
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  WAIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PropertyListingStatus {
  DRAFT
  ACTIVE
  UNDER_OFFER
  SOLD
  WITHDRAWN
}

enum TravelPauseStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AmenityBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum HealthVitalType {
  BP_SYSTOLIC
  BP_DIASTOLIC
  BLOOD_SUGAR
  WEIGHT
  SPO2
  HEART_RATE
}

enum HealthRecordType {
  PRESCRIPTION
  LAB_REPORT
  SCAN
  VACCINATION
  INSURANCE
}

enum DomesticHelpRole {
  COOK
  MAID
  DRIVER
  GARDENER
  OTHER
}

enum DomesticAttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
}

enum ParkingSlotType {
  OWNED
  VISITOR
}

enum VehicleType {
  CAR
  TWO_WHEELER
  SUV
}

enum CommunityPostStatus {
  ACTIVE
  REMOVED
}

enum AgmMeetingStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum AgmResolutionResult {
  PASSED
  REJECTED
  PENDING
}

enum DocumentRequestType {
  NOC
  OWNERSHIP_CERT
  PAYMENT_CERT
  OTHER
}

enum DocumentRequestStatus {
  PENDING
  PROCESSING
  READY
  DELIVERED
}

enum SubscriptionFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum InfrastructureType {
  LIFT
  POWER
  WATER
  GENERATOR
  WIFI
}

enum InfrastructureStatus {
  OPERATIONAL
  MAINTENANCE
  FAULT
}

enum LaundryStatus {
  REQUESTED
  PICKED_UP
  PROCESSING
  READY
  DELIVERED
}

enum LaundryBookingStatus {
  SCHEDULED
  PICKED_UP
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum LaundryType {
  WASH_AND_FOLD
  DRY_CLEAN
  IRON_ONLY
  WASH_AND_IRON
}

enum PackageStatus {
  PENDING
  COLLECTED
}

enum ConciergeRequestType {
  TAXI
  COURIER
  PHARMACY
  FORM_HELP
  OTHER
}

enum ConciergeStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ConciergeType {
  GROCERY
  PHARMACY
  CAB
  COURIER
  PARCEL_COLLECTION
  OTHER
}

enum FeedbackCategory {
  SUGGESTION
  COMPLAINT
  APPRECIATION
  OTHER
}

enum FeedbackStatus {
  SUBMITTED
  ACKNOWLEDGED
  RESOLVED
}

enum TravelRequestStatus {
  PENDING
  APPROVED
  ACTIVE
  RETURNED
  CANCELLED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum NoticeTargetType {
  ALL
  RESIDENTS
  OWNERS
  TENANTS
  STAFF
  BLOCK
}

enum VisitorStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  DENIED
  EXPIRED
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  MISSED
}

enum StaffNoticeCategory {
  POLICY
  SAFETY
  SCHEDULE
  WELFARE
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

enum WalletTxnStatus {
  PENDING
  COMPLETED
  FAILED
}

enum IncidentType {
  THEFT
  TRESPASSING
  VANDALISM
  SUSPICIOUS_ACTIVITY
  EMERGENCY
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum RoundStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum FeedbackTarget {
  STAFF
  SERVICE
  FACILITY
  CANTEEN
  EVENT
  GENERAL
}

// ─── Multi-tenant Root ────────────────────────────────────────────────────────

model Society {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String
  pincode   String
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  flats               Flat[]
  staff               StaffMember[]
  serviceRequests     ServiceRequest[]
  complaints          Complaint[]
  canteenMenus        CanteenMenu[]
  events              Event[]
  medicalStaff        MedicalStaff[]
  notices             Notice[]
  polls               Poll[]
  sosAlerts           SosAlert[]
  propertyListings    PropertyListing[]
  holidays            Holiday[]
  staffNotices        StaffNotice[]
  staffMessages       StaffMessage[]
  staffMessageGroups  StaffMessageGroup[]
  trainingMaterials   TrainingMaterial[]
  recognitions        Recognition[]
  lostFoundItems      LostFoundItem[]
  amenities           Amenity[]
  parkingSlots        ParkingSlot[]
  communityPosts      CommunityPost[]
  agmMeetings         AgmMeeting[]
  documentRequests    DocumentRequest[]
  infrastructureItems InfrastructureItem[]
  packages            Package[]
  feedback            Feedback[]
  emergencyContacts   EmergencyContact[]
  securityRounds      SecurityRound[]
  societyBudgets      SocietyBudget[]
  conciergeRequests   ConciergeRequest[]
  laundryBookings      LaundryBooking[]
  securityIncidents    SecurityIncident[]
  housekeepingRequests HousekeepingRequest[]
  pestControlSchedules PestControlSchedule[]
  canteenPreOrders     CanteenPreOrder[]
  vendors              Vendor[]
  vendorOrders         VendorOrder[]
  showInDirectory      Boolean               @default(false)
  archivedAt           DateTime?

  @@map("societies")
}

// ─── Users & Profiles ────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid())
  phone             String
  name              String?
  email             String?
  gender            String?
  dateOfBirth       DateTime?
  fcmToken          String?
  deviceToken       String?
  notificationPrefs Json?
  role              UserRole
  status            UserStatus @default(PENDING)
  adminNote         String?
  societyId         String
  managedBlocks     String[]   @default([])
  totpSecret        Bytes?
  totpEnabled       Boolean    @default(false)
  lastActiveAt      DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  society     Society      @relation(fields: [societyId], references: [id])
  resident    Resident?
  staffMember StaffMember?
  sosAlerts   SosAlert[]
  consentLog  ConsentLog[]

  @@unique([phone, societyId])
  @@index([societyId])
  @@map("users")
}

model Resident {
  id              String         @id @default(uuid())
  userId          String         @unique
  flatId          String
  type            ResidentType   @default(TENANT)
  moveInDate      DateTime?
  moveOutDate     DateTime?
  aadhaar         Bytes?
  panNumber       String?
  idProof         String?
  addressProof    String?
  documentsStatus DocumentStatus @default(PENDING)
  isAnonymised    Boolean        @default(false)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  flat               Flat                @relation(fields: [flatId], references: [id])
  visitors           Visitor[]
  serviceRequests    ServiceRequest[]
  complaints         Complaint[]
  appointments       Appointment[]
  maintenanceBills   MaintenanceBill[]
  payments           Payment[]
  travelPauses       TravelPause[]
  propertyListings   PropertyListing[]
  pollVotes          PollVote[]
  eventRegistrations EventRegistration[]
  showInDirectory    Boolean             @default(false)
  walletBalance      Decimal             @default(0)
  /** Optional: { name, phone } for resident emergency contact (BRD resident profile). */
  emergencyContact   Json?
  dateOfBirth        DateTime?
  roleNote           String?
  appActivatedAt     DateTime?
  walletTxns         WalletTransaction[]
  familyMembers      FamilyMember[]
  healthVitals       HealthVital[]
  medications        Medication[]
  healthRecords      HealthRecord[]
  domesticHelps      DomesticHelp[]
  parkingSlot        ParkingSlot?        @relation(fields: [parkingSlotId], references: [id])
  parkingSlotId      String?
  vehicles           Vehicle[]
  amenityBookings    AmenityBooking[]
  communityPosts     CommunityPost[]
  postComments       PostComment[]
  documentRequests   DocumentRequest[]
  subscriptions      Subscription[]
  laundryRequests    LaundryRequest[]
  packages           Package[]
  conciergeRequests  ConciergeRequest[]
  feedback           Feedback[]
  dishRatings        DishRating[]
  eventFeedback      EventFeedback[]
  travelRequests     TravelRequest[]
  propertyInterests  PropertyInterest[]
  laundryBookings        LaundryBooking[]
  postLikes              PostLike[]
  housekeepingRequests   HousekeepingRequest[]
  canteenPreOrders       CanteenPreOrder[]
  vendorOrders           VendorOrder[]

  @@index([flatId])
  @@map("residents")
}

model Flat {
  id        String   @id @default(uuid())
  societyId String
  block     String
  floor     Int
  number    String
  areaSqft  Float?
  createdAt DateTime @default(now())

  society   Society           @relation(fields: [societyId], references: [id])
  residents Resident[]
  bills     MaintenanceBill[]

  @@unique([societyId, block, number])
  @@index([societyId])
  @@map("flats")
}

model StaffMember {
  id               String    @id @default(uuid())
  userId           String    @unique
  societyId        String
  designation      String
  department       String?
  categories       String[]
  salaryStructure  Json?
  joiningDate      DateTime?
  leavingDate      DateTime?
  familyDetails    Json?
  emergencyContact Json?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                User              @relation(fields: [userId], references: [id])
  society             Society           @relation(fields: [societyId], references: [id])
  attendance          StaffAttendance[]
  leaveRequests       LeaveRequest[]
  reviews             StaffReview[]
  shifts              Shift[]
  taskNotes           TaskNote[]
  salarySlips         SalarySlip[]
  recognitions        Recognition[]     @relation("StaffRecognitions")
  awardedRecognitions Recognition[]     @relation("AwardedRecognitions")
  staffMessages       StaffMessage[]
  securityRounds      SecurityRound[]
  documents           StaffDocument[]
  staffLoans          StaffLoan[]

  @@index([societyId])
  @@map("staff_members")
}

model StaffDocument {
  id            String    @id @default(uuid())
  staffMemberId String
  documentType  String
  fileUrl       String
  uploadedAt    DateTime  @default(now())
  uploadedBy    String?
  verifiedAt    DateTime?
  verifiedById  String?

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId])
  @@map("staff_documents")
}

model StaffLoan {
  id            String      @id @default(uuid())
  staffMemberId String
  amount        Decimal     @db.Decimal(10, 2)
  reason        String?
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id])

  @@index([staffMemberId])
  @@map("staff_loans")
}

// ─── Visitor Management ───────────────────────────────────────────────────────

model Visitor {
  id                String        @id @default(uuid())
  residentId        String
  name              String
  phone             String?
  purpose           String?
  qrToken           String        @unique @default(uuid())
  photoUrl          String?
  vehicleNo         String?
  status            VisitorStatus @default(EXPECTED)
  validFrom         DateTime?
  validUntil        DateTime?
  entryAt           DateTime?
  exitAt            DateTime?
  checkedInBy       String?
  isRecurring       Boolean       @default(false)
  recurringSchedule Json?
  approvalStatus    String        @default("PENDING")
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime      @default(now())

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@index([qrToken])
  @@index([residentId, status])
  @@map("visitors")
}

// ─── Service Requests ─────────────────────────────────────────────────────────

model ServiceRequest {
  id            String               @id @default(uuid())
  societyId     String
  residentId    String
  assignedToIds String[]             @default([])
  category      String
  description   String
  adminNote     String?
  status        ServiceRequestStatus @default(PENDING)
  slaDeadline   DateTime?
  scheduledTime DateTime?
  preferredTime String?
  resolvedAt    DateTime?
  confirmedAt   DateTime?
  disputeReason String?
  rating        Decimal?             @db.Decimal(3, 2)
  ratingText    String?
  ratedAt       DateTime?
  proofPhotos     Json?
  ratingNote      String?
  tags            String[]
  isPaid          Boolean              @default(false)
  autoAssigned    Boolean              @default(false)
  reminderMinutes Int?
  reminderSentAt  DateTime?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  acceptedAt     DateTime?
  rejectedReason String?

  society    Society        @relation(fields: [societyId], references: [id])
  resident   Resident       @relation(fields: [residentId], references: [id])
  photos     ServicePhoto[]
  notes      TaskNote[]

  @@index([societyId, status])
  @@index([residentId])
  @@map("service_requests")
}

model ServicePhoto {
  id               String       @id @default(uuid())
  serviceRequestId String
  phase            ServicePhase
  url              String
  lat              Float?
  lng              Float?
  takenAt          DateTime     @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  @@map("service_photos")
}

// ─── Complaints ───────────────────────────────────────────────────────────────

model Complaint {
  id          String          @id @default(uuid())
  societyId   String
  residentId  String
  category    String
  title       String
  description String
  isAnonymous Boolean         @default(false)
  status      ComplaintStatus @default(OPEN)
  adminNote   String?
  resolvedAt  DateTime?
  rating      Decimal?        @db.Decimal(3, 2)
  ratingText  String?
  ratingNote  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  society  Society  @relation(fields: [societyId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  @@index([societyId, status])
  @@map("complaints")
}

// ─── Canteen ──────────────────────────────────────────────────────────────────

model CanteenMenu {
  id        String        @id @default(uuid())
  societyId String
  date      DateTime      @db.Date
  mealType  String
  dishes    CanteenDish[]
  createdAt DateTime      @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@unique([societyId, date, mealType])
  @@map("canteen_menus")
}

model CanteenDish {
  id          String   @id @default(uuid())
  menuId      String
  name        String
  calories    Int?
  allergens   String[]
  isVeg       Boolean  @default(true)
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)

  menu        CanteenMenu  @relation(fields: [menuId], references: [id])
  dishRatings DishRating[]

  @@map("canteen_dishes")
}

// ─── Events ───────────────────────────────────────────────────────────────────

model Event {
  id          String      @id @default(uuid())
  societyId   String
  title       String
  description String?
  category    String?
  date        DateTime
  venue       String
  capacity    Int?
  imageUrl    String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  society       Society             @relation(fields: [societyId], references: [id])
  registrations EventRegistration[]
  eventFeedback EventFeedback[]

  @@index([societyId])
  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  residentId   String
  waitlisted   Boolean  @default(false)
  registeredAt DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  @@unique([eventId, residentId])
  @@map("event_registrations")
}

// ─── Medical ──────────────────────────────────────────────────────────────────

model MedicalStaff {
  id          String   @id @default(uuid())
  societyId   String
  name        String
  designation String
  photoUrl    String?
  schedule    Json     @default("[]")
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  society      Society       @relation(fields: [societyId], references: [id])
  appointments Appointment[]

  @@index([societyId])
  @@map("medical_staff")
}

model Appointment {
  id           String            @id @default(uuid())
  residentId   String
  doctorId     String
  date         DateTime          @db.Date
  timeSlot     String
  status       AppointmentStatus @default(BOOKED)
  notes        String?
  cancelReason String?
  rating       Decimal?          @db.Decimal(3, 2)
  ratingText   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  resident Resident     @relation(fields: [residentId], references: [id])
  doctor   MedicalStaff @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, date, timeSlot])
  @@index([residentId])
  @@map("appointments")
}

model SosAlert {
  id               String    @id @default(uuid())
  societyId        String
  residentId       String
  /** Optional context (e.g. staff at a flat, resident situation). */
  note             String?
  lat              Float?
  lng              Float?
  status           SosStatus @default(ACTIVE)
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  responseTimeSecs Int?
  createdAt        DateTime  @default(now())

  society  Society @relation(fields: [societyId], references: [id])
  resident User    @relation(fields: [residentId], references: [id])

  @@index([societyId, status])
  @@map("sos_alerts")
}

// ─── Payments & Maintenance ───────────────────────────────────────────────────

model MaintenanceBill {
  id         String        @id @default(uuid())
  flatId     String
  residentId String
  period     String
  breakdown  Json
  total      Decimal       @db.Decimal(10, 2)
  dueDate    DateTime
  status        PaymentStatus @default(PENDING)
  paymentMethod String?
  createdAt     DateTime      @default(now())

  flat     Flat      @relation(fields: [flatId], references: [id])
  resident Resident  @relation(fields: [residentId], references: [id])
  payments Payment[]

  @@index([flatId])
  @@index([residentId])
  @@index([residentId, status])
  @@map("maintenance_bills")
}

model Payment {
  id         String        @id @default(uuid())
  billId     String
  residentId String
  amount     Decimal       @db.Decimal(10, 2)
  method     String?
  gatewayRef String?       @unique
  receiptUrl String?
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  bill     MaintenanceBill @relation(fields: [billId], references: [id])
  resident Resident        @relation(fields: [residentId], references: [id])

  @@index([billId])
  @@map("payments")
}

// ─── Property & Travel ────────────────────────────────────────────────────────

model PropertyListing {
  id          String                @id @default(uuid())
  societyId   String
  residentId  String
  areaSqft    Float
  price       Decimal               @db.Decimal(14, 2)
  furnished   Boolean               @default(false)
  description String?
  photos      String[]
  status      PropertyListingStatus @default(DRAFT)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  society   Society            @relation(fields: [societyId], references: [id])
  resident  Resident           @relation(fields: [residentId], references: [id])
  interests PropertyInterest[]

  @@index([societyId])
  @@map("property_listings")
}

model TravelPause {
  id               String            @id @default(uuid())
  residentId       String
  startDate        DateTime
  returnDate       DateTime
  actualReturnDate DateTime?
  servicesPaused   String[]
  reason           String?
  status           TravelPauseStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  resident Resident @relation(fields: [residentId], references: [id])

  @@map("travel_pauses")
}

// ─── Notices & Polls ──────────────────────────────────────────────────────────

model Notice {
  id          String           @id @default(uuid())
  societyId   String
  title       String
  body        String
  category    String?
  target      NoticeTargetType @default(ALL)
  targetBlock String?
  isPinned    Boolean          @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@map("notices")
}

model Poll {
  id          String   @id @default(uuid())
  societyId   String
  question    String
  options     Json
  deadline    DateTime
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  society Society    @relation(fields: [societyId], references: [id])
  votes   PollVote[]

  @@index([societyId])
  @@map("polls")
}

model PollVote {
  id              String   @id @default(uuid())
  pollId          String
  residentId      String
  selectedOptions Json
  votedAt         DateTime @default(now())

  poll     Poll     @relation(fields: [pollId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  @@unique([pollId, residentId])
  @@map("poll_votes")
}

// ─── Staff Operations ─────────────────────────────────────────────────────────

model StaffAttendance {
  id                String           @id @default(uuid())
  staffId           String
  date              DateTime         @db.Date
  checkIn           DateTime?
  checkOut          DateTime?
  checkInLat        Float?
  checkInLng        Float?
  checkOutLat       Float?
  checkOutLng       Float?
  status            AttendanceStatus @default(PRESENT)
  isLate            Boolean          @default(false)
  isEarlyDeparture  Boolean          @default(false)
  photoUrl          String?
  overtimeMinutes   Int              @default(0)
  lateReason        String?
  earlyReason       String?
  breakMinutes      Int              @default(0)
  biometricVerified Boolean          @default(false)
  deviceId          String?
  createdAt         DateTime         @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@map("staff_attendance")
}

model LeaveRequest {
  id        String      @id @default(uuid())
  staffId   String
  type      String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  adminNote String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@map("leave_requests")
}

model StaffReview {
  id         String   @id @default(uuid())
  staffId    String
  residentId String
  rating     Int
  comment    String?
  flagged    Boolean  @default(false)
  flagReason String?
  createdAt  DateTime @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@map("staff_reviews")
}

// ─── Compliance & Audit ───────────────────────────────────────────────────────

model ConsentLog {
  id        String    @id @default(uuid())
  userId    String
  action    String
  version   String?
  revokedAt DateTime?
  details   Json?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, action])
  @@map("consent_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  module     String?
  routePath  String?
  method     String?
  ipAddress  String?
  userAgent  String?
  actorId    String?
  actorRole  String?
  before     Json?
  after      Json?
  societyId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([societyId])
  @@index([actorId, createdAt])
  @@index([societyId, createdAt])
  @@map("audit_logs")
}

// ─── Staff App Extensions ─────────────────────────────────────────────────────

model Holiday {
  id         String   @id @default(uuid())
  societyId  String
  date       DateTime @db.Date
  name       String
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId, date])
  @@map("holidays")
}

model Shift {
  id        String      @id @default(uuid())
  staffId   String
  date      DateTime    @db.Date
  startTime String
  endTime   String
  role      String?
  status    ShiftStatus @default(SCHEDULED)
  createdAt DateTime    @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@index([staffId, date])
  @@map("shifts")
}

model TaskNote {
  id               String   @id @default(uuid())
  serviceRequestId String
  staffId          String
  body             String
  voiceUrl         String?
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  staff          StaffMember    @relation(fields: [staffId], references: [id])

  @@index([serviceRequestId])
  @@map("task_notes")
}

model StaffNotice {
  id          String              @id @default(uuid())
  societyId   String
  title       String
  body        String
  category    StaffNoticeCategory @default(POLICY)
  publishedAt DateTime?
  pinnedUntil DateTime?
  createdAt   DateTime            @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@map("staff_notices")
}

model StaffMessageGroup {
  id        String   @id @default(uuid())
  societyId String
  name      String
  memberIds String[]
  createdAt DateTime @default(now())

  society  Society        @relation(fields: [societyId], references: [id])
  messages StaffMessage[]

  @@index([societyId])
  @@map("staff_message_groups")
}

model StaffMessage {
  id        String   @id @default(uuid())
  societyId String
  groupId   String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  society Society           @relation(fields: [societyId], references: [id])
  group   StaffMessageGroup @relation(fields: [groupId], references: [id])
  sender  StaffMember       @relation(fields: [senderId], references: [id])

  @@index([groupId])
  @@map("staff_messages")
}

model TrainingMaterial {
  id          String   @id @default(uuid())
  societyId   String
  title       String
  description String?
  fileUrl     String
  category    String?
  createdAt   DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@map("training_materials")
}

model Recognition {
  id          String   @id @default(uuid())
  societyId   String
  staffId     String
  message     String
  awardedById String?
  createdAt   DateTime @default(now())

  society   Society      @relation(fields: [societyId], references: [id])
  staff     StaffMember  @relation("StaffRecognitions", fields: [staffId], references: [id])
  awardedBy StaffMember? @relation("AwardedRecognitions", fields: [awardedById], references: [id])

  @@index([societyId, staffId])
  @@map("recognitions")
}

model LostFoundItem {
  id          String   @id @default(uuid())
  societyId   String
  loggedById  String?
  title       String
  description String?
  location    String?
  photoUrl    String?
  status      String   @default("FOUND")
  createdAt   DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@index([societyId])
  @@map("lost_found_items")
}

model SalarySlip {
  id          String   @id @default(uuid())
  staffId     String
  period      String
  grossPay    Decimal  @db.Decimal(12, 2)
  deductions  Decimal  @default(0) @db.Decimal(12, 2)
  netPay      Decimal  @db.Decimal(12, 2)
  fileUrl     String?
  generatedAt DateTime @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])

  @@unique([staffId, period])
  @@index([staffId])
  @@map("salary_slips")
}

// ─── Amenities ────────────────────────────────────────────────────────────────

model Amenity {
  id            String   @id @default(cuid())
  societyId     String
  name          String
  description   String?
  photos        Json     @default("[]")
  capacity      Int
  depositAmount Decimal  @default(0) @db.Decimal(10, 2)
  rules         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  society  Society          @relation(fields: [societyId], references: [id])
  bookings AmenityBooking[]

  @@index([societyId])
  @@map("amenities")
}

model AmenityBooking {
  id            String               @id @default(cuid())
  amenityId     String
  residentId    String
  date          DateTime             @db.Date
  startSlot     String
  endSlot       String
  guestCount    Int                  @default(1)
  status        AmenityBookingStatus @default(PENDING)
  paymentStatus PaymentStatus        @default(PENDING)
  depositPaid   Boolean              @default(false)
  rating        Decimal?             @db.Decimal(3, 2)
  ratingText    String?
  ratingAt      DateTime?
  createdAt     DateTime             @default(now())

  amenity  Amenity  @relation(fields: [amenityId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  @@index([amenityId])
  @@index([residentId])
  @@map("amenity_bookings")
}

// ─── Family Members ───────────────────────────────────────────────────────────

model FamilyMember {
  id           String   @id @default(cuid())
  residentId   String
  name         String
  phone        String
  relationship String
  permissions  Json     @default("{}")
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@map("family_members")
}

// ─── Health ───────────────────────────────────────────────────────────────────

model HealthVital {
  id         String          @id @default(cuid())
  residentId String
  type       HealthVitalType
  value      Decimal         @db.Decimal(10, 4)
