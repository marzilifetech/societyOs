  @@index([residentId])
  @@map("medications")
}

model HealthRecord {
  id         String           @id @default(cuid())
  residentId String
  type       HealthRecordType
  title      String
  fileUrl    String
  date       DateTime
  notes      String?
  createdAt  DateTime         @default(now())

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@map("health_records")
}

// ─── Domestic Help ────────────────────────────────────────────────────────────

model DomesticHelp {
