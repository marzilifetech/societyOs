  createdAt   DateTime              @default(now())

  resident Resident @relation(fields: [residentId], references: [id])
  society  Society  @relation(fields: [societyId], references: [id])

  @@index([residentId])
  @@index([societyId])
  @@map("document_requests")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id         String                @id @default(cuid())
  residentId String
  vendorId   String?
  items      Json                  @default("[]")
  frequency  SubscriptionFrequency @default(DAILY)
  startDate  DateTime
  isPaused   Boolean               @default(false)
  pauseUntil DateTime?
  createdAt  DateTime              @default(now())

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@map("subscriptions")
}

// ─── Infrastructure ───────────────────────────────────────────────────────────

model InfrastructureItem {
  id            String               @id @default(cuid())
  societyId     String
  name          String
  type          InfrastructureType
  status        InfrastructureStatus @default(OPERATIONAL)
  lastUpdatedBy String?
  updatedAt     DateTime             @updatedAt
  createdAt     DateTime             @default(now())

  society   Society         @relation(fields: [societyId], references: [id])
  incidents InfraIncident[]

  @@index([societyId])
  @@map("infrastructure_items")
}

model InfraIncident {
  id          String    @id @default(cuid())
  itemId      String
  reportedBy  String
  description String
  photoUrl    String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime  @default(now())

  item InfrastructureItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@map("infra_incidents")
}

// ─── Laundry ──────────────────────────────────────────────────────────────────

model LaundryRequest {
  id                  String        @id @default(cuid())
  residentId          String
  itemsDescription    String
